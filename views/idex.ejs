<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Inventory & Stock Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">

  <!-- Top Navbar -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="h-9 w-9 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-lg">
          📦
        </div>
        <h1 class="text-lg font-semibold text-slate-800 tracking-tight">StockMaster Pro</h1>
      </div>
      <a href="#new-product-modal" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors shadow-sm">
        + Add Product
      </a>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Metrics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Total Products</p>
        <p class="text-3xl font-bold text-slate-900 mt-2"><%= totalProducts %></p>
      </div>
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Total Stock Value</p>
        <p class="text-3xl font-bold text-emerald-600 mt-2">$<%= totalInventoryValue %></p>
      </div>
      <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Low Stock Warnings</p>
        <p class="text-3xl font-bold <%= lowStockCount > 0 ? 'text-amber-600' : 'text-slate-900' %> mt-2">
          <%= lowStockCount %>
        </p>
      </div>
    </div>

    <!-- Search Bar -->
    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm mb-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <form action="/" method="GET" class="w-full sm:w-96 flex gap-2">
        <input 
          type="text" 
          name="search" 
          placeholder="Search by name or category..." 
          value="<%= searchQuery %>" 
          class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
        />
        <button type="submit" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2 rounded-lg">
          Search
        </button>
      </form>
      <% if (searchQuery) { %>
        <a href="/" class="text-xs text-indigo-600 hover:underline">Clear search</a>
      <% } %>
    </div>

    <!-- Products Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-slate-700 uppercase text-xs border-b border-slate-200">
            <tr>
              <th class="px-6 py-3.5">Product</th>
              <th class="px-6 py-3.5">Category</th>
              <th class="px-6 py-3.5">Cost</th>
              <th class="px-6 py-3.5">Price</th>
              <th class="px-6 py-3.5">Stock</th>
              <th class="px-6 py-3.5">Status</th>
              <th class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% if (products.length === 0) { %>
              <tr>
                <td colspan="7" class="px-6 py-8 text-center text-slate-400">
                  No products found. Click "+ Add Product" above to create one.
                </td>
              </tr>
            <% } %>
            <% products.forEach(product => { %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4 font-medium text-slate-900">
                  <%= product.name %>
                  <% if (product.sku) { %>
                    <span class="block text-xs text-slate-400 font-normal">SKU: <%= product.sku %></span>
                  <% } %>
                </td>
                <td class="px-6 py-4"><%= product.category || '—' %></td>
                <td class="px-6 py-4">$<%= parseFloat(product.cost_price).toFixed(2) %></td>
                <td class="px-6 py-4 font-semibold text-slate-800">$<%= parseFloat(product.selling_price).toFixed(2) %></td>
                <td class="px-6 py-4 font-medium"><%= product.stock_quantity %> units</td>
                <td class="px-6 py-4">
                  <% if (product.stock_quantity <= 0) { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800">
                      Out of stock
                    </span>
                  <% } else if (product.stock_quantity <= product.low_stock_threshold) { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                      Low stock (<%= product.stock_quantity %> left)
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                      In stock
                    </span>
                  <% } %>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <!-- Quick Sell Form -->
                  <form action="/sales" method="POST" class="inline-flex items-center gap-1">
                    <input type="hidden" name="product_id" value="<%= product.id %>">
                    <input type="number" name="quantity_sold" value="1" min="1" max="<%= product.stock_quantity %>" class="w-12 px-1 py-1 border border-slate-300 rounded text-center text-xs">
                    <button type="submit" <%= product.stock_quantity <= 0 ? 'disabled' : '' %> class="bg-emerald-600 disabled:opacity-40 text-white text-xs px-2.5 py-1 rounded hover:bg-emerald-700">
                      Sell
                    </button>
                  </form>

                  <!-- Delete -->
                  <form action="/products/<%= product.id %>?_method=DELETE" method="POST" class="inline">
                    <button type="submit" onclick="return confirm('Delete this product?')" class="text-rose-600 hover:text-rose-800 text-xs font-medium px-2 py-1">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Add Product Section -->
    <div id="new-product-modal" class="mt-12 bg-white rounded-xl border border-slate-200 shadow-sm p-6 max-w-2xl mx-auto">
      <h2 class="text-lg font-semibold text-slate-800 mb-4">Add New Inventory Item</h2>
      <form action="/products" method="POST" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Product Name *</label>
            <input type="text" name="name" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">SKU / Code</label>
            <input type="text" name="sku" placeholder="e.g. PRD-001" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Category</label>
            <input type="text" name="category" placeholder="e.g. Beverages" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Cost Price ($)</label>
            <input type="number" step="0.01" name="cost_price" value="0.00" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Selling Price ($) *</label>
            <input type="number" step="0.01" name="selling_price" required value="0.00" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Initial Stock Quantity *</label>
            <input type="number" name="stock_quantity" required value="10" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Low Stock Alert Threshold</label>
            <input type="number" name="low_stock_threshold" value="5" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>
        </div>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg text-sm transition-colors mt-2">
          Save Product
        </button>
      </form>
    </div>

  </main>
</body>
</html>